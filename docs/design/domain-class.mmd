classDiagram
    direction LR

    class Customer {
        +Guid Id
        +string Name
        +VerificationLevel Level
        +bool IsBlocked
    }
    class Agent {
        +Guid Id
        +Guid WalletId
    }
    class Wallet {
        +Guid Id
        +WalletOwnerType OwnerType
        +Money Available()
        +Money Held()
        +Hold(amount, reason) LedgerEntry
        +Release(amount, reason) LedgerEntry
        +Capture(amount, reason) LedgerEntry
    }
    class LedgerEntry {
        +Guid Id
        +Guid WalletId
        +decimal Amount
        +EntryType Type
        +string Reason
        +DateTime CreatedAt
    }
    class Biller {
        +string Code
        +string Name
        +bool IsActive
        +decimal MinAmount
        +decimal MaxAmount
    }
    class Payment {
        +Guid Id
        +string IdempotencyKey
        +Guid PayerWalletId
        +Guid InitiatedByUserId
        +Guid AgentId (nullable)
        +Money Amount
        +Money Fee
        +string RejectReason
        +IPaymentState State
        +Reject(reason)
        +HoldFunds()
        +SendToBiller()
        +Complete()
        +Fail()
        +MarkUnknown()
        +Refund()
        -ChangeState(next)
    }

    class IPaymentState {
        <<interface>>
        +Reject(payment, reason)
        +HoldFunds(payment)
        +SendToBiller(payment)
        +Complete(payment)
        +Fail(payment)
        +MarkUnknown(payment)
        +Refund(payment)
    }
    class InitiatedState
    class FundsHeldState
    class SentToBillerState
    class UnknownState
    class FailedState
    class CompletedState
    class RejectedState
    class RefundedState

    class IBillerGateway {
        <<interface>>
        +Inquiry(request) BillInfo
        +Pay(request) PayResult
    }
    class ElectroCoAdapter
    class AquaCoAdapter
    class TopUpNetAdapter
    class NetCoAdapter
    class BillerGatewayFactory {
        +Create(billerCode) IBillerGateway
    }

    class IFeeStrategy {
        <<interface>>
        +Calculate(amount) Money
    }
    class FixedFee
    class PercentageFee
    class TieredFee
    class PromotionFee

    class IFraudRule {
        <<interface>>
        +SetNext(rule) IFraudRule
        +Check(context) RuleResult
    }
    class FraudRuleBase {
        <<abstract>>
        -IFraudRule next
        +Check(context) RuleResult
        #Evaluate(context) RuleResult
    }
    class FraudContext {
        +Customer Customer
        +Wallet Wallet
        +Money Amount
        +int PaymentsInLastMinute
        +Money PaidToday
    }
    class DailyLimitRule
    class VelocityRule
    class BlockedAccountRule

    class IPaymentObserver {
        <<interface>>
        +OnCompleted(payment)
        +OnFailed(payment)
    }
    class SmsNotifier
    class PushNotifier
    class AgentCommissionHandler

    class IUnitOfWork {
        <<interface>>
        +ExecuteInTransaction(work)
    }
    class PaymentService {
        +Pay(command) Payment
    }

    Customer "1" --> "1" Wallet
    Agent "1" --> "1" Wallet
    Wallet "1" --> "*" LedgerEntry
    Payment "*" --> "1" Wallet : payer
    Payment "*" --> "0..1" Agent : at terminal of
    Payment "*" --> "1" Biller
    Payment --> IPaymentState

    IPaymentState <|.. InitiatedState
    IPaymentState <|.. FundsHeldState
    IPaymentState <|.. SentToBillerState
    IPaymentState <|.. UnknownState
    IPaymentState <|.. FailedState
    IPaymentState <|.. CompletedState
    IPaymentState <|.. RejectedState
    IPaymentState <|.. RefundedState

    IBillerGateway <|.. ElectroCoAdapter
    IBillerGateway <|.. AquaCoAdapter
    IBillerGateway <|.. TopUpNetAdapter
    IBillerGateway <|.. NetCoAdapter
    BillerGatewayFactory ..> IBillerGateway

    IFeeStrategy <|.. FixedFee
    IFeeStrategy <|.. PercentageFee
    IFeeStrategy <|.. TieredFee
    IFeeStrategy <|.. PromotionFee

    IFraudRule <|.. FraudRuleBase
    FraudRuleBase <|-- DailyLimitRule
    FraudRuleBase <|-- VelocityRule
    FraudRuleBase <|-- BlockedAccountRule
    IFraudRule ..> FraudContext

    IPaymentObserver <|.. SmsNotifier
    IPaymentObserver <|.. PushNotifier
    IPaymentObserver <|.. AgentCommissionHandler

    PaymentService --> IUnitOfWork
    PaymentService --> IFraudRule
    PaymentService --> IFeeStrategy
    PaymentService --> BillerGatewayFactory
    PaymentService --> IPaymentObserver
    PaymentService --> Payment
